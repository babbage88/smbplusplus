  "paths": {
    "/health/db/{TYPE}": {
      "get": {
        "security": [
          {
            "bearer": []
          }
        ],
        "description": "Supported check types for insert operations: \"insert\", \"delete\", \"read\".\nAll other types default to a read health check.",
        "tags": [
          "dbHealthCheck"
        ],
        "summary": "Performs database health check and returns a respoonse.\nDetermines the type of health check to perform based on the URL path parameter \"type\".\nIf the check type corresponds to an insert/write operation, it executes an insert health check.\nOtherwise, it defaults to a read health check.",
        "operationId": "idOfdbHealthCheck",
        "parameters": [
          {
            "type": "string",
            "description": "Type of DB HealthCheck",
            "name": "TYPE",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "DbHeathCheckResponse",
            "schema": {
              "$ref": "#/definitions/DbHeathCheckResponse"
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "login"
        ],
        "summary": "Login a user and return token.",
        "operationId": "idOfloginEndpoint",
        "parameters": [
          {
            "x-go-name": "Body",
            "name": "body",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/UserLoginRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/responses/AuthToken"
          }
        }
      }
    }
  },
